{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-hooks"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off",
    "unicorn/filename-case": "off"
  },
  "ignorePatterns": ["public/", "node_modules/", "data/"],
  "env": {
    "builtin": true,
    "browser": true
  }
}